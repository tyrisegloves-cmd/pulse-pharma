# ─────────────────────────────────────────────────────────────────────────────
# Supabase (required)
# ─────────────────────────────────────────────────────────────────────────────
# Find these in your Supabase project dashboard:
#   https://supabase.com/dashboard → (your project) → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://bjqkpiffgwxqtgyidqwv.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_NZDRPxlonP9VpVnzo074fA_H_UW9CzZ
# ─────────────────────────────────────────────────────────────────────────────
# Paystack (payments) — https://dashboard.paystack.com/#/settings/developers
# ─────────────────────────────────────────────────────────────────────────────
# SECRET KEY — server-side only (API routes + webhook). NEVER expose in the
# browser, never prefix with NEXT_PUBLIC_, never commit a real key.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# PUBLIC KEY — safe for the browser; reserved for any future inline checkout.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Public base URL used to build Paystack's callback_url (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# Supabase service role (server-side only)
# ─────────────────────────────────────────────────────────────────────────────
# Supabase → Settings → API → service_role (secret). Bypasses RLS — used ONLY
# by the payment webhook + verify routes. Never expose in the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service_role-secret-here
